# DEV-ONLY: Example .env file for local development. Do NOT include a real
# .env in release artifacts. The preflight script will block builds that
# include dangerous flags like HOMEBOT_E2E or HOMEBOT_DIRECT_OLLAMA.
#
# Copy this to `.env` during development and set values as needed.

# Example entries:
# HOMEBOT_DIRECT_OLLAMA=true
# OLLAMA_URL=http://127.0.0.1:11434

# n8n encryption key — encrypts stored credentials in n8n.
# Generate with: [System.Convert]::ToBase64String((1..32|%{[byte](Get-Random -Max 256)}))
# N8N_ENCRYPTION_KEY=replace-with-a-strong-random-secret

# ── HomeBot Pro — offline signed license keys (RECOMMENDED, no account needed) ──
# Sell today through any payment method: run generate-keypair.mjs once, then
# issue-license.mjs per sale (see docs/SELLING_AND_LICENSING.md). The customer
# pastes the key into Settings → HomeBot Pro; the app verifies it offline.
#
# Where the "Upgrade to Pro" button sends the user (your purchase page):
# HOMEBOT_CHECKOUT_URL=https://your-store.example.com/homebot-pro
# Optional: override the embedded verification public key (base64 SPKI DER):
# HOMEBOT_LICENSE_PUBLIC_KEY=

# ── HomeBot Pro — Lemon Squeezy licensing (OPTIONAL alternative) ────────────────
# Only needed if you prefer LS-managed keys. Leave BLANK to skip. NEVER commit.
# LEMONSQUEEZY_API_KEY=          # LS API key (Bearer) — secret
# LEMONSQUEEZY_STORE_ID=         # numeric LS store id
# LEMONSQUEEZY_PRODUCT_ID=       # Pro product id (license validation scoping)
# LEMONSQUEEZY_CHECKOUT_URL=     # checkout deep link used in upgrade prompts
# LEMONSQUEEZY_API_BASE=https://api.lemonsqueezy.com/v1  # override for tests only
