{
  "name": "homebot-tool-registry",
  "version": "1.0.4",
  "description": "Standalone ToolRegistry module for HomeBot",
  "main": "src/toolRegistry.ts",
  "scripts": {
    "smoke": "npx ts-node src/test.ts",
    "test": "npx jest",
    "soak": "npx ts-node scripts/soak-test.ts",
    "docs:check": "node scripts/check-docs-drift.mjs",
    "docs:write": "node scripts/check-docs-drift.mjs --write"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/json-stable-stringify": "^1.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "better-sqlite3": "^12.11.1",
    "json-stable-stringify": "^1.3.0"
  }
}
