{
  "$comment": "OpenRouter model-router config. Tier model IDs and fallbacks live here, not in code. Prices are USD per 1M tokens (OpenRouter list prices, 10 Nov 2026) and are used only to estimate cost when a response carries no usage.cost. See src/model-router/README.md.",
  "baseUrl": "https://openrouter.ai/api/v1",
  "monthlyCapUsd": 35,
  "live": false,
  "ledgerPath": null,
  "cacheControlPrefixes": [
    "anthropic/",
    "qwen/"
  ],
  "cacheTtl": null,
