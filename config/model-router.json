      "maxTokens": 4096,
      "maxPrice": {
        "prompt": 0.1,
        "completion": 0.7
      },
      "pricing": {
        "prompt": 0.03,
        "completion": 0.13
      }
    },
    "mid": {
      "model": "anthropic/claude-sonnet-5.5",
      "fallbacks": [
        "openai/gpt-6.1-terra"
      ],
      "maxTokens": 8192,
      "maxPrice": {
        "prompt": 2,
        "completion": 10
      },
      "pricing": {
        "prompt": 2,
        "completion": 10
      }
    },
    "top": {
      "model": "anthropic/claude-opus-5.5",
      "fallbacks": [
        "openai/gpt-6.1-sol"
      ],
      "maxTokens": 16384,
      "maxPrice": {
        "prompt": 4,
        "completion": 20
      },
      "pricing": {
        "prompt": 4,
        "completion": 20
      }
    }
  }
