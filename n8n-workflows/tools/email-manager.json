                  {
                      "parameters":  {
                                         "jsCode":  "const body = $input.first()?.json?.body ?? $input.first()?.json ?? {};\nconst action = (body.action || \u0027list_inbox\u0027).toLowerCase();\nconst allowed = [\u0027draft\u0027,\u0027send\u0027,\u0027list_inbox\u0027];\nif (!allowed.includes(action)) {\n  throw new Error(\u0027Invalid action. Must be one of: \u0027 + allowed.join(\u0027, \u0027));\n}\nconst to        = body.to      || \u0027\u0027;\nconst subject   = body.subject || \u0027\u0027;\nconst bodyText  = body.body    || \u0027\u0027;\nconst cc        = body.cc      || \u0027\u0027;\nconst count     = Number(body.count) || 10;\nconst confirmed = body.confirmed === true || body.confirmed === \u0027true\u0027;\nif (action === \u0027send\u0027 \u0026\u0026 !confirmed) {\n  throw new Error(\u0027send requires confirmed=true â€” user must explicitly approve sending email\u0027);\n}\nreturn [{ json: { action, to, subject, bodyText, cc, count, confirmed } }];"
                                     },
                      "id":  "parse-params",
                      "name":  "Parse Parameters",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       460,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "command":  "=powershell.exe -NoProfile -NonInteractive -File \"C:\\Users\\adenk\\Desktop\\sadie\\scripts\\tools\\powershell\\SafetyValidation.ps1\" -ToolName \"email\" -Action \"{{ $json.action }}\" -RulesPath \"C:\\Users\\adenk\\Desktop\\sadie\\config\\safety-rules.json\""
                                     },
                      "id":  "safety-validation",
                      "name":  "Safety Validation",
                      "type":  "n8n-nodes-base.executeCommand",
                      "typeVersion":  1,
                      "position":  [
                                       680,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const raw = $input.first()?.json?.stdout ?? \u0027\u0027;\nlet validation;\ntry { validation = JSON.parse(raw); } catch { validation = { allowed: true }; }\nif (validation.allowed === false) {\n  throw new Error(\u0027Safety validation blocked email operation: \u0027 + (validation.reason || \u0027policy\u0027));\n}\nconst params = $(\u0027Parse Parameters\u0027).first().json;\nreturn [{ json: params }];"
                                     },
