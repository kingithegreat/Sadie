                  {
                      "parameters":  {
                                         "jsCode":  "const body = $input.first()?.json?.body ?? $input.first()?.json ?? {};\nconst action = (body.action || \u0027read\u0027).toLowerCase();\nconst content = body.content || \u0027\u0027;\nconst confirmed = body.confirmed === true || body.confirmed === \u0027true\u0027;\nif (![\u0027read\u0027,\u0027write\u0027,\u0027clear\u0027].includes(action)) {\n  throw new Error(\u0027Invalid action. Must be: read, write, or clear\u0027);\n}\nreturn [{ json: { action, content, confirmed } }];"
                                     },
                      "id":  "parse-params",
                      "name":  "Parse Parameters",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       460,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "command":  "=powershell.exe -NoProfile -NonInteractive -File \"C:\\Users\\adenk\\Desktop\\sadie\\scripts\\tools\\powershell\\SafetyValidation.ps1\" -ToolName \"clipboard\" -Action \"{{ $json.action }}\" -RulesPath \"C:\\Users\\adenk\\Desktop\\sadie\\config\\safety-rules.json\""
                                     },
                      "id":  "safety-validation",
                      "name":  "Safety Validation",
                      "type":  "n8n-nodes-base.executeCommand",
                      "typeVersion":  1,
                      "position":  [
                                       680,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const raw = $input.first()?.json?.stdout ?? \u0027\u0027;\nlet validation;\ntry { validation = JSON.parse(raw); } catch { validation = { allowed: true }; }\nif (validation.allowed === false) {\n  throw new Error(\u0027Safety validation blocked clipboard operation: \u0027 + (validation.reason || \u0027policy\u0027));\n}\nconst params = $(\u0027Parse Parameters\u0027).first().json;\nreturn [{ json: params }];"
                                     },
                      "id":  "check-validation",
                      "name":  "Check Validation",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
