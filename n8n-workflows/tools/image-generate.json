  "name": "HomeBot Image Generate (Hybrid)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "image-generate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
