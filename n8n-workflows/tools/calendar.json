{
  "name": "SADIE Calendar Tool (Phase 6)",
  "active": true,
  "nodes": [
    {
      "id": "start",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "sadie/tools/calendar",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "6215b7c2-8ee9-4ce1-a827-12595d3e2ea9"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first()?.json?.body ?? $input.first()?.json ?? {};\nconst action = (body.action || 'list_events').toLowerCase();\nconst allowed = ['list_events','add_event','get_today'];\nif (!allowed.includes(action)) {\n  throw new Error('Invalid action. Must be one of: ' + allowed.join(', '));\n}\nconst subject   = body.subject   || '';\nconst startTime = body.startTime || body.start_time || '';\nconst endTime   = body.endTime   || body.end_time   || '';\nconst bodyText  = body.body      || '';\nconst days      = Number(body.days) || 7;\nconst confirmed = body.confirmed === true || body.confirmed === 'true';\nreturn [{ json: { action, subject, startTime, endTime, bodyText, days, confirmed } }];"
      },
      "id": "parse-params",
      "name": "Parse Parameters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        590,
        300
      ]
    },
    {
      "parameters": {
        "command": "=powershell.exe -NoProfile -NonInteractive -File \"C:\\Users\\adenk\\Desktop\\sadie\\scripts\\tools\\powershell\\SafetyValidation.ps1\" -ToolName \"calendar\" -Action \"{{ $json.action }}\" -RulesPath \"C:\\Users\\adenk\\Desktop\\sadie\\config\\safety-rules.json\""
      },
      "id": "safety-validation",
      "name": "Safety Validation",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        810,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first()?.json?.stdout ?? '';\nlet validation;\ntry { validation = JSON.parse(raw); } catch { validation = { allowed: true }; }\nif (validation.allowed === false) {\n  throw new Error('Safety validation blocked calendar operation: ' + (validation.reason || 'policy'));\n}\nconst params = $('Parse Parameters').first().json;\nreturn [{ json: params }];"
      },
      "id": "check-validation",
      "name": "Check Validation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1030,
        300
      ]
    },
    {
      "parameters": {
        "command": "=powershell.exe -NoProfile -NonInteractive -File \"C:\\Users\\adenk\\Desktop\\sadie\\scripts\\tools\\powershell\\CalendarOps.ps1\" -Action \"{{ $json.action }}\" -Subject \"{{ $json.subject }}\" -StartTime \"{{ $json.startTime }}\" -EndTime \"{{ $json.endTime }}\" -Body \"{{ $json.bodyText }}\" -Days {{ $json.days }} -Confirmed {{ $json.confirmed }}"
      },
      "id": "execute-calendar",
      "name": "Execute Calendar Op",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first()?.json?.stdout ?? $input.first()?.json?.stderr ?? '';\nlet result;\ntry { result = JSON.parse(raw); } catch { result = { success: false, error: raw || 'No output from CalendarOps.ps1' }; }\nreturn [{ json: result }];"
      },
      "id": "format-result",
      "name": "Format Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1470,
        300
      ]
    },
    {
      "id": "sadie-auth-guard",
      "name": "Auth Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        350,
        300
      ],
      "parameters": {
        "jsCode": "const secret = process.env.SADIE_WEBHOOK_SECRET;\nif (secret) {\n  const hdrs = $input.first()?.json?.headers || {};\n  const incoming = hdrs['x-sadie-auth'] || hdrs['X-SADIE-Auth'] || '';\n  if (incoming !== secret) {\n    throw new Error('Unauthorized: invalid or missing X-SADIE-Auth header');\n  }\n}\nreturn $input.all();"
      }
    }
  ],
