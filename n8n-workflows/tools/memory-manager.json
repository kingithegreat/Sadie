                  {
                      "parameters":  {
                                         "jsCode":  "const fs = require(\u0027fs\u0027);\nconst prefsPath = \u0027C:/Users/adenk/Desktop/sadie/memory/json-store/user-preferences.json\u0027;\nconst params = $input.item.json.params;\n\nlet preferences = {};\nif (fs.existsSync(prefsPath)) {\n  preferences = JSON.parse(fs.readFileSync(prefsPath, \u0027utf8\u0027));\n}\n\nconst key = params.key;\nconst value = params.value;\n\npreferences[key] = {\n  value: value,\n  updated_at: new Date().toISOString()\n};\n\nfs.writeFileSync(prefsPath, JSON.stringify(preferences, null, 2));\n\nreturn {\n  json: {\n    success: true,\n    action: \u0027update_preference\u0027,\n    key: key,\n    message: \u0027Preference updated successfully\u0027\n  }\n};"
                                     },
