{
    "name":  "Image Generation Workflow",
    "nodes":  [
                  {
                      "parameters":  {
                                         "httpMethod":  "POST",
                                         "path":  "generate-image",
                                         "responseMode":  "responseNode",
                                         "options":  {

                                                     }
                                     },
                      "id":  "webhook-trigger",
                      "name":  "Webhook",
                      "type":  "n8n-nodes-base.webhook",
                      "typeVersion":  1,
                      "position":  [
                                       250,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "model":  "dall-e-3",
                                         "prompt":  "={{ $json.body.prompt }}",
                                         "size":  "1024x1024",
                                         "quality":  "standard",
                                         "style":  "vivid"
                                     },
                      "id":  "image-generator",
                      "name":  "OpenAI Image Generation",
                      "type":  "n8n-nodes-base.openAi",
                      "typeVersion":  1,
                      "position":  [
                                       450,
                                       300
                                   ],
                      "credentials":  {
                                          "openAiApi":  {
                                                            "id":  "1",
                                                            "name":  "OpenAI API"
                                                        }
                                      }
                  },
                  {
                      "parameters":  {
                                         "respondWith":  "json",
                                         "responseBody":  "={{ { \"success\": true, \"imageUrl\": $json.data[0].url, \"prompt\": $json.body.prompt } }}"
                                     },
                      "id":  "response-node",
                      "name":  "Respond to Webhook",
                      "type":  "n8n-nodes-base.respondToWebhook",
                      "typeVersion":  1,
                      "position":  [
                                       650,
                                       300
                                   ]
                  }
              ],
    "connections":  {
                        "Webhook":  {
                                        "main":  [
                                                     [
                                                         {
                                                             "node":  "OpenAI Image Generation",
                                                             "type":  "main",
                                                             "index":  0
                                                         }
                                                     ]
                                                 ]
                                    },
                        "OpenAI Image Generation":  {
                                                        "main":  [
                                                                     [
                                                                         {
                                                                             "node":  "Respond to Webhook",
                                                                             "type":  "main",
                                                                             "index":  0
                                                                         }
                                                                     ]
                                                                 ]
                                                    }
                    },
    "settings":  {
                     "executionOrder":  "v1"
                 },
    "versionId":  "1.0.0",
    "meta":  {
                 "instanceId":  "sadie-instance"
             },
    "tags":  [
                 {
                     "name":  "AI",
                     "id":  "1"
                 },
                 {
                     "name":  "Image Generation",
                     "id":  "2"
                 }
             ],
    "active":  true
}
