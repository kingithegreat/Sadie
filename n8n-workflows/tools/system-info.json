                                       250,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const params = $input.item.json.tool_call.parameters;\nconst action = params.action || \u0027get_system_info\u0027;\n\n// Map n8n action names to SystemInfo.ps1 info types\nconst actionMap = {\n  \u0027get_system_info\u0027: \u0027system\u0027,\n  \u0027get_disk_usage\u0027: \u0027disk\u0027,\n  \u0027get_process_list\u0027: \u0027processes\u0027,\n  \u0027get_memory_info\u0027: \u0027memory\u0027,\n  \u0027get_network_info\u0027: \u0027network\u0027,\n  \u0027get_all_info\u0027: \u0027all\u0027\n};\n\nconst mappedInfoType = actionMap[action] || \u0027all\u0027;\n\nreturn {\n  json: {\n    info_type: mappedInfoType,\n    params: params\n  }\n};"
                                     },
                      "id":  "parse-params",
                      "name":  "Parse Parameters",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       450,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "command":  "powershell.exe -ExecutionPolicy Bypass -NoProfile -File \"C:\\Users\\adenk\\Desktop\\sadie\\scripts\\tools\\powershell\\SafetyValidation.ps1\" -ToolName \"system_info\" -Action \"{{ $json.info_type }}\" -Parameters @{{ $json.params | ConvertTo-Json -Compress }} -UserConfirmed $true",
                                         "cwd":  "C:\\Users\\adenk\\Desktop\\sadie"
                                     },
                      "id":  "safety-validation",
                      "name":  "Safety Validation",
                      "type":  "n8n-nodes-base.executeCommand",
                      "typeVersion":  1,
                      "position":  [
                                       650,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const stdout = $input.item.json.stdout || \u0027\u0027;\nconst stderr = $input.item.json.stderr || \u0027\u0027;\n\nlet validationResult;\ntry {\n  validationResult = JSON.parse(stdout);\n} catch (e) {\n  validationResult = {\n    success: false,\n    error: \u0027Failed to parse safety validation output\u0027,\n    raw_output: stdout\n  };\n}\n\nif (!validationResult.success) {\n  return {\n    json: {\n      status: \u0027validation_failed\u0027,\n      error: validationResult.error || \u0027Safety validation failed\u0027,\n      validation: validationResult\n    }\n  };\n}\n\n// Continue to system info operation\nreturn {\n  json: {\n    ...$input.item.json,\n    validation: validationResult\n  }\n};"
                                     },
                      "id":  "check-validation",
                      "name":  "Check Validation",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       850,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "command":  "powershell.exe -ExecutionPolicy Bypass -NoProfile -File \"C:\\Users\\adenk\\Desktop\\sadie\\scripts\\tools\\powershell\\SystemInfo.ps1\" -InfoType \"{{ $json.info_type }}\"{{ $json.params.top_processes ? ` -TopProcesses ${$json.params.top_processes}` : \u0027\u0027 }}",
                                         "cwd":  "C:\\Users\\adenk\\Desktop\\sadie"
                                     },
                      "id":  "execute-systeminfo",
                      "name":  "Execute SystemInfo",
                      "type":  "n8n-nodes-base.executeCommand",
                      "typeVersion":  1,
                      "position":  [
                                       1050,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const stdout = $input.item.json.stdout || \u0027\u0027;\nconst stderr = $input.item.json.stderr || \u0027\u0027;\n\nlet scriptResult;\ntry {\n  scriptResult = JSON.parse(stdout);\n} catch (e) {\n  scriptResult = {\n    success: false,\n    error: \u0027Failed to parse SystemInfo output\u0027,\n    raw_output: stdout\n  };\n}\n\nreturn {\n  json: {\n    status: scriptResult.success ? \u0027success\u0027 : \u0027failure\u0027,\n    timestamp: scriptResult.timestamp || new Date().toISOString(),\n    operation: \u0027SystemInfo\u0027,\n    info_type: scriptResult.info_type || $input.item.json.info_type,\n    data: scriptResult.data || null,\n    error: scriptResult.error || null,\n    validation: $input.item.json.validation\n  }\n};"
                                     },
