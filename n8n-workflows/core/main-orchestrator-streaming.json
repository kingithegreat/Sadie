                      "parameters":  {
                                         "jsCode":  "// Prepare messages for Ollama /api/chat (non-streaming orchestrator behaviour)\nconst body = $input.item.json.body || $input.item.json || {};\nconst userMessage = body.message || body.text || \u0027\u0027;\nconst conversationId = body.conversation_id || \u0027default\u0027;\nconst userId = body.user_id || \u0027user\u0027;\nconst systemPrompt = `You are Sadie, a helpful AI assistant. Be concise and friendly.`;\n\nconst messages = [\n  { role: \u0027system\u0027, content: systemPrompt },\n  { role: \u0027user\u0027, content: userMessage }\n];\n\nreturn {\n  json: {\n    model: \u0027llama3.2:3b\u0027,\n    messages: messages,\n    stream: false,\n    user_message: userMessage,\n    conversation_id: conversationId,\n    user_id: userId\n  }\n};"
                                     },
