{
  "name": "HomeBot Main Orchestrator (Streaming)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "homebot/chat/stream",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "webhookId": "homebot-streaming"
    },
    {
      "parameters": {
        "jsCode": "// Prepare messages for Ollama /api/chat (non-streaming orchestrator behaviour)\nconst body = $input.item.json.body || $input.item.json || {};\nconst userMessage = body.message || body.text || '';\nconst conversationId = body.conversation_id || 'default';\nconst userId = body.user_id || 'user';\nconst systemPrompt = `You are HomeBot, a helpful AI assistant. Be concise and friendly.`;\n\nconst messages = [\n  { role: 'system', content: systemPrompt },\n  { role: 'user', content: userMessage }\n];\n\nreturn {\n  json: {\n    model: 'llama3.2:3b',\n    messages: messages,\n    stream: false,\n    user_message: userMessage,\n    conversation_id: conversationId,\n    user_id: userId\n  }\n};"
      },
      "id": "prepare-streaming-request",
      "name": "Prepare Streaming Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": $json.model,\n  \"messages\": $json.messages,\n  \"stream\": true\n} }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "stream-from-ollama",
      "name": "Stream from Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "binary",
        "responseBody": "={{ $binary }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/event-stream"
              },
              {
                "name": "Cache-Control",
                "value": "no-cache"
              },
              {
                "name": "Connection",
                "value": "keep-alive"
              }
            ]
          }
        }
      },
      "id": "respond-stream",
      "name": "Respond Stream",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        980,
        300
      ]
    },
    {
      "id": "homebot-auth-guard",
      "name": "Auth Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        300
      ],
      "parameters": {
        "jsCode": "// Auth Guard — deployed by HomeBot; validates X-HOMEBOT-Auth.\nlet secret = \"\";\nif (!secret) secret = process.env.HOMEBOT_WEBHOOK_SECRET;\nconst hdrs = $input.first()?.json?.headers || {};\nconst incoming = hdrs['x-homebot-auth'] || hdrs['X-HOMEBOT-Auth'] || '';\nif (!secret) {\n  throw new Error('Unauthorized: this workflow has no HomeBot secret. Deploy it from HomeBot instead of importing it by hand.');\n}\nif (incoming !== secret) {\n  throw new Error('Unauthorized: invalid or missing X-HOMEBOT-Auth header');\n}\nreturn $input.all();"
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Auth Guard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Streaming Request": {
      "main": [
        [
          {
            "node": "Stream from Ollama",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stream from Ollama": {
      "main": [
        [
          {
            "node": "Respond Stream",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auth Guard": {
      "main": [
        [
          {
            "node": "Prepare Streaming Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
